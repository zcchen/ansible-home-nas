LDAP_BASE_DN="{{ nas__domain_ldap | split('.') | map('regex_replace', '^(.*)$', 'dc=\\g<1>') | join(',') }}"
LDAP_DOMAIN="{{ nas__domain_ldap }}"

LDAP_READONLY_USER="true"

AUTHELIA_AUTHENTICATION_BACKEND_LDAP_BASE_DN="$LDAP_BASE_DN"
AUTHELIA_AUTHENTICATION_BACKEND_LDAP_USER="cn=$LDAP_READONLY_USER_USERNAME,$LDAP_BASE_DN"
AUTHELIA_AUTHENTICATION_BACKEND_LDAP_PASSWORD="$LDAP_READONLY_USER_PASSWORD"
