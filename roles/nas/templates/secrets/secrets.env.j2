# This env file contains the environment vars usually ONLY for admins.
#   Never put those which may be shared to end users here, like, samba-share related.


# req. by certbot image in rev-proxy
{{ nas__dns_api__envname }}="{{ nas__dns_api__token }}"

# req. by openldap image in ldap
LDAP_ADMIN_PASSWORD="{{ nas__ldap__admin_password }}"
LDAP_CONFIG_PASSWORD="{{ nas__ldap__config_password }}"
LDAP_READONLY_USER_USERNAME="{{ nas__ldap__readonly_username }}"
LDAP_READONLY_USER_PASSWORD="{{ nas__ldap__readonly_password }}"
LDAPEXT__SSP_USER_USERNAME="{{ nas__ldap__ssp_username }}"
LDAPEXT__SSP_USER_PASSWORD="{{ nas__ldap__ssp_password }}"
# req. by ssp image in ldap
LDAPSSP__SECRETS_KEYPHRASE="{{ _nas__secrets_ldapssp }}"
# req. by authelia image in ldap
AUTHELIA__SECRETS_SESSION="{{ _nas__secrets_authelia_session }}"
AUTHELIA__SECRETS_STORAGE="{{ _nas__secrets_authelia_storage }}"
# req. by authelia image in ldap & nextcloud apps
NC_SECRET__AUTHELIA_CLIENT_ID="{{ nas__oidc__nextcloud_id }}"
NC_SECRET__AUTHELIA_CLIENT_SECRET="{{ nas__oidc__nextcloud_secret }}"

# req.by nextcloud
NC_SECRET__POSTGRES_PASSWORD="{{ nas__nextcloud__db_passwd }}"
NC_SECRET__POSTGRES_DB="{{ nas__nextcloud__db_name }}"
NC_SECRET__POSTGRES_USER="{{ nas__nextcloud__db_user }}"
NEXTCLOUD_ADMIN_USER="{{ nas__nextcloud__admin_username }}"
NEXTCLOUD_ADMIN_PASSWORD="{{ nas__nextcloud__admin_password }}"

# req. by onlyoffice image in onlyoffice
ONLYOFFICE__JWT_SECRET="{{ _nas__secrets_onlyoffice_jwt }}"
